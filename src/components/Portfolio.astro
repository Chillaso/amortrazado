---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { portfolio } from '../data/portfolio';
// Every work pinned to one long board, in the order of src/data/portfolio.ts. A click opens the
// piece at full size on a sheet of paper.

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/images/*.{png,jpg,jpeg,webp,avif}', { eager: true });
const byName = Object.fromEntries(Object.entries(files).map(([path, mod]) => [path.split('/').pop(), mod.default]));

const tilts = [-1.6, 1.2, -0.7, 2, -2.2, 0.9, 1.6, -1.1];
const tapes = ['var(--sage)', 'var(--blush)', null, 'var(--blush)', 'var(--sage)', null];

const works = await Promise.all(
  portfolio.map(async (work, i) => {
    const src = byName[work.image];
    if (!src) throw new Error(`Portfolio: no image "${work.image}" in src/assets/images/`);
    const full = await getImage({ src, width: Math.min(src.width, 1400), format: 'webp' });
    return { ...work, src, full, tilt: tilts[i % tilts.length], tape: tapes[i % tapes.length], tapeLeft: 20 + ((i * 17) % 45) };
  }),
);
---

<section class="portfolio wrap section" aria-labelledby="portfolio-title">
  <header class="portfolio-head">
    <h1 id="portfolio-title" class="page-title">Portfolio</h1>
    <p class="portfolio-lead">
      Invitaciones, papelería para celebraciones e ilustraciones personalizadas: algunas de las
      historias que he tenido la suerte de trazar.
    </p>
    <p class="note portfolio-hint" aria-hidden="true">
      <span class="hint-dot"></span> toca una pieza para verla en grande
    </p>
  </header>

  <div class="board" role="list" data-board>
    {works.map((w) => (
      <div class="board-item" role="listitem" data-ratio={(w.src.height / w.src.width).toFixed(3)}>
        <figure class="print" style={`--tilt:${w.tilt}deg`} data-drop>
          {w.tape && <span class="tape" style={`--tape:${w.tape}; top:-0.7rem; left:${w.tapeLeft}%; width:4.5rem`}></span>}
          <button
            type="button"
            class="piece-open"
            data-full={w.full.src}
            data-width={w.full.attributes.width}
            data-height={w.full.attributes.height}
            data-alt={w.alt}
            aria-haspopup="dialog"
          >
            <Image src={w.src} widths={[360, 560, 800]} sizes="(max-width: 36rem) 46vw, (max-width: 64rem) 46vw, 30vw" alt={w.alt} />
            <span class="piece-badge" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></svg>
            </span>
            <span class="sr-only">Ver en grande</span>
          </button>
        </figure>
      </div>
    ))}
  </div>

  <div class="portfolio-end">
    <p class="lead">¿Os imagináis vuestra historia aquí?</p>
    <a class="button" href="#contacto">Pedir presupuesto</a>
  </div>
</section>

<dialog class="story" aria-label="Pieza ampliada">
  <div class="story-card">
    <span class="tape" style="--tape:var(--sage); top:-0.7rem; left:12%; --tape-tilt:-4deg"></span>
    <span class="tape" style="top:-0.6rem; right:10%; --tape-tilt:5deg"></span>
    <figure class="story-figure">
      <img alt="" />
    </figure>
    <form method="dialog" class="story-x-form">
      <button class="story-x" type="submit" aria-label="Cerrar">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </form>
  </div>
</dialog>

<script>
  // Masonry that keeps the list order left to right: each piece goes into the shortest column.
  // Heights come from the image ratios, so it lays out before any image loads. Without this
  // script the board falls back to CSS columns.
  const board = document.querySelector<HTMLElement>('[data-board]');
  if (board) {
    const items = [...board.querySelectorAll<HTMLElement>('.board-item')];
    const wide = matchMedia('(min-width: 64.01rem)');
    let count = 0;
    const layout = () => {
      const n = wide.matches ? 3 : 2;
      if (n === count) return;
      count = n;
      const cols = Array.from({ length: n }, () => {
        const col = document.createElement('div');
        col.className = 'board-col';
        return col;
      });
      const heights = new Array(n).fill(0);
      items.forEach((item) => {
        const i = heights.indexOf(Math.min(...heights));
        cols[i].append(item);
        heights[i] += Number(item.dataset.ratio) + 0.15;
      });
      board.replaceChildren(...cols);
      board.classList.add('is-masonry');
    };
    layout();
    wide.addEventListener('change', layout);
  }

  const dialog = document.querySelector<HTMLDialogElement>('dialog.story');
  if (dialog) {
    const img = dialog.querySelector('img')!;
    let opener: HTMLElement | null = null;

    document.querySelectorAll<HTMLButtonElement>('.piece-open').forEach((button) => {
      button.addEventListener('click', () => {
        const d = button.dataset;
        img.src = d.full ?? '';
        img.alt = d.alt ?? '';
        img.width = Number(d.width);
        img.height = Number(d.height);
        opener = button;
        dialog.showModal();
      });
    });

    // A click on the backdrop (outside the card) closes it
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => opener?.focus());
  }
</script>

<style>
  .portfolio-head { max-width: 44rem; }
  .page-title { font-size: var(--step-display); line-height: 0.98; letter-spacing: -0.03em; }
  .portfolio-lead { margin-top: 1.5rem; max-width: 40ch; font-size: var(--step-lead); line-height: 1.3; }
  .portfolio-hint { display: flex; align-items: center; gap: 0.6rem; margin-top: 1.5rem; rotate: -1.5deg; }
  .hint-dot {
    display: inline-block;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 50%;
    background: var(--crimson);
    flex: none;
  }

  /* Uneven columns, like prints pinned on a board as they came */
  .board {
    margin-top: clamp(3rem, 6vw, 5rem);
    columns: 3 16rem;
    column-gap: clamp(1.25rem, 3vw, 2.5rem);
  }
  .board.is-masonry { display: flex; align-items: flex-start; gap: clamp(1.25rem, 3vw, 2.5rem); columns: auto; }
  /* The columns are made by the script below, so they carry no scope attribute: match them globally */
  .board :global(.board-col) { flex: 1; min-width: 0; }
  .board-item {
    break-inside: avoid;
    padding: 0.9rem 0.25rem clamp(1.5rem, 3vw, 2.5rem);
  }
  .board .print img { height: auto; }

  .piece-open {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }
  .piece-open:focus-visible { outline: 2px solid var(--crimson); outline-offset: 4px; }
  .piece-badge {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--crimson);
    color: #fff;
    box-shadow: 0 4px 10px -4px rgb(46 27 33 / 0.5);
    transition: transform 260ms var(--ease-out);
  }
  .piece-badge svg { width: 1.1rem; fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; }
  @media (hover: hover) and (pointer: fine) {
    .piece-open:hover .piece-badge { transform: rotate(90deg) scale(1.08); }
  }

  .portfolio-end {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.25rem 2rem;
    margin-top: clamp(2rem, 5vw, 4rem);
    text-align: center;
  }

  /* The enlarged piece: a sheet of paper taped over the board */
  .story {
    width: fit-content;
    max-width: calc(100% - 2rem);
    max-height: calc(100dvh - 3rem);
    padding: 0;
    border: 0;
    background: transparent;
    overflow: visible;
    color: var(--ink);
  }
  .story::backdrop { background: rgb(46 27 33 / 0.6); }
  .story-card {
    position: relative;
    max-height: calc(100dvh - 3rem);
    overflow: auto;
    padding: clamp(0.75rem, 2vw, 1.25rem);
    background: var(--paper);
    border-radius: 3px;
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.6);
    rotate: -0.6deg;
  }
  .story-figure { margin: 0; }
  .story-figure img { display: block; width: auto; height: auto; max-width: 100%; max-height: calc(100dvh - 7rem); }
  .story-x-form { position: absolute; top: 0.5rem; right: 0.5rem; }
  .story-x {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 2px 8px rgb(46 27 33 / 0.25);
    cursor: pointer;
  }
  .story-x svg { width: 1.4rem; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
  .story-x:hover { background: var(--surface); }

  @media (prefers-reduced-motion: no-preference) {
    .story[open] .story-card { animation: lay-down 420ms var(--ease-out); }
    .story[open]::backdrop { animation: fade 300ms ease; }
    @keyframes lay-down { from { opacity: 0; transform: translateY(28px) rotate(2.5deg) scale(0.97); } }
    @keyframes fade { from { opacity: 0; } }
  }

  @media (max-width: 48rem) {
    .story-card { rotate: 0deg; }
    .story-figure img { max-height: calc(100dvh - 6rem); }
  }
  @media (max-width: 36rem) {
    .board { columns: 2; column-gap: 0.9rem; }
    .board.is-masonry { gap: 0.9rem; }
    .board-item { padding-inline: 0; }
    .piece-badge { width: 1.9rem; height: 1.9rem; right: 0.4rem; bottom: 0.4rem; }
  }
</style>
