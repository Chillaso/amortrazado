---
import papeleriaCollage from '../assets/images/papeleria-collage.webp';
import invitacionFlores from '../assets/images/invitacion-flores.webp';
import ilusAmigas from '../assets/images/ilus-amigas.webp';
// The headline is traced by hand as the page opens; beside it, the stationery laid on the table.
---

<section class="hero wrap" aria-labelledby="hero-title">
  <div class="hero-grid grid">
    <div class="hero-text">
      <h1 id="hero-title" class="hero-title">
        Historias trazadas con amor
        <svg class="trace" viewBox="0 0 600 40" preserveAspectRatio="none" aria-hidden="true">
          <path pathLength="1" d="M6 28 C 90 14, 170 34, 260 22 S 420 10, 500 20 S 570 28, 594 14" />
        </svg>
      </h1>
      <p class="hero-sentence">
        Cada historia tiene algo que la hace única, y merece una forma especial de contarla. En Amor
        Trazado, transformo momentos, recuerdos y emociones en ilustraciones y papelería personalizada,
        cuidando cada detalle para que hable de quienes sois y de aquello que os hace especiales.
        Porque, a veces, son las pequeñas cosas las que guardan los sentimientos más grandes.
      </p>
      <div class="hero-actions">
        <a class="button" href="#contacto">Pedir presupuesto</a>
        <a class="link" href="#packs">Ver los packs</a>
      </div>
    </div>

    <div class="hero-collage" data-pile>
      <p class="note collage-note" aria-hidden="true" data-float="24">
        Papelería personalizada
        <svg class="arrow" viewBox="0 0 60 50" data-draw data-draw-delay="1.1">
          <path pathLength="1" d="M8 6 C 18 22, 30 34, 50 40 M50 40 L 38 42 M50 40 L 44 30" />
        </svg>
      </p>
      <figure class="print print-main" style="--tilt:-1.4deg" data-drop>
        <span class="tape" style="--tape:var(--sage); top:-0.7rem; left:12%; --tape-tilt:-4deg"></span>
        <span class="tape" style="top:-0.6rem; right:10%; --tape-tilt:5deg"></span>
        <img
          src={papeleriaCollage.src}
          width="1800"
          height="750"
          fetchpriority="high"
          alt="Papelería de la boda de Vicky y Víctor en tonos lila: invitación, timeline, minuta, tarjetas y sellos ilustrados con la finca"
        />
      </figure>
      <figure class="print print-polaroid" style="--tilt:4deg" data-drop>
        <span class="tape" style="--tape:var(--blush); top:-0.7rem; left:30%; width:4.5rem"></span>
        <img
          src={invitacionFlores.src}
          width="720"
          height="900"
          alt="Dos manos sostienen una invitación ilustrada delante de un ramo de flores naranjas y granates"
        />
        <figcaption class="note">Detalles únicos</figcaption>
      </figure>
      <figure class="print print-polaroid print-polaroid-2" style="--tilt:-3deg" data-drop>
        <span class="tape" style="--tape:var(--sage); top:-0.7rem; left:34%; width:4.5rem; --tape-tilt:4deg"></span>
        <img
          src={ilusAmigas.src}
          width="720"
          height="900"
          alt="Ilustración de un grupo de amigas abrazadas, en tonos verdes, malvas y azules"
        />
      </figure>
    </div>
  </div>
</section>

<style>
  .hero { padding-top: clamp(1.5rem, 5vh, 4rem); padding-bottom: calc(var(--section) * 0.7); }
  .hero-grid { align-items: center; row-gap: 3rem; }
  .hero-text { grid-column: 1 / span 5; }

  .hero-title {
    position: relative;
    font-size: var(--step-display);
    line-height: 0.98;
    letter-spacing: -0.03em;
    padding-bottom: 0.3em;
  }
  .trace {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 88%;
    height: 0.32em;
    overflow: visible;
  }
  .trace path {
    fill: none;
    stroke: var(--crimson);
    stroke-width: 4.5;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .trace path {
      stroke-dashoffset: 1;
      animation: trace 1.6s 0.35s var(--ease-out) forwards;
    }
    @keyframes trace { to { stroke-dashoffset: 0; } }
  }

  .hero-sentence { margin-top: 1.75rem; max-width: 36ch; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.75rem; margin-top: 2.25rem; }

  .hero-collage {
    grid-column: 6 / -1;
    position: relative;
    padding: 4rem 0 12rem 3rem;
  }
  .print-main { max-width: 52rem; margin-left: auto; }
  .print-main img { aspect-ratio: 12 / 5; }
  .print-polaroid {
    position: absolute;
    left: 0;
    bottom: 0;
    width: clamp(9rem, 30%, 14.5rem);
    padding-bottom: 0.25rem;
  }
  .print-polaroid-2 { left: auto; right: 8%; bottom: 1.5rem; width: clamp(8rem, 26%, 12.5rem); }
  .print-polaroid img { aspect-ratio: 4 / 5; }
  .print-polaroid figcaption { text-align: center; font-size: 1.3rem; color: var(--ink); }

  .collage-note {
    position: absolute;
    top: 0;
    left: 0;
    max-width: 15rem;
    rotate: -3deg;
  }
  .arrow {
    width: 3rem;
    margin: 0.1rem 0 0 7rem;
    overflow: visible;
  }
  .arrow path { stroke-dasharray: 1; fill: none; stroke: var(--sage-deep); stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }

  @media (max-width: 64rem) {
    .hero-text, .hero-collage { grid-column: 1 / -1; }
    .hero-text { max-width: 40rem; }
    .hero-collage { padding: 4rem 0 10rem 0; }
    .collage-note { left: auto; right: 0; text-align: right; }
    .arrow { margin-left: auto; margin-right: 2rem; transform: scaleX(-1); }
  }
  @media (max-width: 36rem) {
    .hero-collage { padding-bottom: 10rem; }
    .print-polaroid { left: auto; right: 0.25rem; width: 38%; }
    .print-polaroid-2 { left: 0.25rem; right: auto; bottom: 1rem; width: 34%; }
    .collage-note { max-width: 11rem; }
  }
</style>
