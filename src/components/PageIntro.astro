---
import { url } from '../lib/url';
// Opening screen for the inner pages: the title large, one sentence, one picture large.
interface Props {
  title: string;
  text: string;
  action: { href: string; label: string };
  image: { src: string; width: number; height: number; alt: string; position?: string };
}
const { title, text, action, image } = Astro.props;
---

<section class="page-intro wrap" aria-labelledby="page-title">
  <div class="grid">
    <div class="page-intro-text">
      <h1 id="page-title" class="page-title" data-reveal>{title}</h1>
      <p data-reveal style="--i:1">{text}</p>
      <a class="button" href={action.href} data-reveal style="--i:2">{action.label}</a>
    </div>
    <figure class="page-intro-figure" data-reveal style="--i:1">
      <div class="shutter">
        <img
          src={url(image.src)}
          width={image.width}
          height={image.height}
          alt={image.alt}
          fetchpriority="high"
          style={image.position ? `object-position:${image.position}` : undefined}
        />
      </div>
    </figure>
  </div>
</section>

<style>
  .page-intro { padding-block: clamp(1.5rem, 5vh, 4rem) calc(var(--section) / 2); overflow-x: clip; }
  .page-intro .grid { align-items: end; row-gap: 2.5rem; }
  .page-intro-text { grid-column: 1 / span 6; padding-bottom: 1rem; }
  .page-title {
    font-size: var(--step-display);
    line-height: 0.95;
    letter-spacing: -0.03em;
  }
  .page-intro-text p { margin-top: 1.75rem; max-width: 36ch; }
  .page-intro-text .button { margin-top: 2rem; }
  .page-intro-figure { grid-column: 7 / -1; margin: 0 calc(-1 * var(--margin)) 0 0; }
  .page-intro-figure .shutter { height: min(78svh, 46rem); }
  .page-intro-figure img { width: 100%; height: 100%; object-fit: cover; background: var(--surface); }

  @media (max-width: 48rem) {
    .page-intro-text, .page-intro-figure { grid-column: 1 / -1; }
    .page-title { font-size: clamp(2.5rem, 11vw, 3.5rem); }
    .page-intro-figure { margin-inline: calc(-1 * var(--margin)); }
    .page-intro-figure .shutter { height: auto; aspect-ratio: 4 / 5; }
  }
</style>
