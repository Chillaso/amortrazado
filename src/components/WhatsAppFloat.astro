---
// The WhatsApp button that stays in the corner of every page, so the chat (with its welcome
// message already typed) is one tap away from anywhere. It slides in once the page has loaded.
import { contact } from '../data/contact';
---

<a class="wa-float" href={contact.whatsapp} target="_blank" rel="noopener noreferrer" aria-label="Escribir a Amor Trazado por WhatsApp">
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9" />
    <path d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1" />
  </svg>
  <span class="wa-float-text" aria-hidden="true">¿Hablamos?</span>
</a>

<style>
  .wa-float {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 60;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 3.5rem;
    padding: 0.5rem 1.35rem 0.5rem 1rem;
    background: #1f7a4d;
    color: #fff;
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 4px 10px -2px rgb(31 122 77 / 0.45), 0 18px 34px -16px rgb(46 27 33 / 0.55);
    transition: transform 200ms var(--ease-out), background-color 180ms ease;
  }
  .wa-float svg {
    width: 1.75rem;
    height: 1.75rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .wa-float:active { transform: scale(0.96); }
  .wa-float:focus-visible { outline: 3px solid var(--crimson); outline-offset: 3px; }
  @media (hover: hover) and (pointer: fine) {
    .wa-float:hover { background: #17603c; transform: translateY(-2px) rotate(-1deg); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .wa-float { animation: wa-in 600ms 1.2s var(--ease-out) both; }
    @keyframes wa-in { from { opacity: 0; transform: translateY(1.5rem) scale(0.9); } }
  }
  @media (max-width: 36rem) {
    .wa-float { min-height: 3.5rem; width: 3.5rem; padding: 0; justify-content: center; }
    .wa-float-text { display: none; }
  }
</style>
