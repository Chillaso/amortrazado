---
import { url } from '../lib/url';
import { contact } from '../data/contact';

const links = [
  { href: url('/papeleria-bodas/'), label: 'Papelería' },
  { href: url('/ilustraciones/'), label: 'Ilustraciones' },
  { href: url('/#packs'), label: 'Packs y precios' },
  { href: url('/portfolio/'), label: 'Portfolio' },
  { href: url('/mi-historia/'), label: 'Mi historia' },
];
---

<header class="site-header wrap">
  <a class="brand" href={url('/')} aria-label="Amor Trazado, inicio">
    <img class="brand-logo" src={url('/images/logo.webp')} width="440" height="160" alt="Amor Trazado" />
  </a>

  <nav class="nav" aria-label="Principal">
    <ul class="nav-list">
      {links.map((l) => <li><a class="link nav-link" href={l.href}>{l.label}</a></li>)}
    </ul>
  </nav>

  <a class="button header-action" href={contact.whatsapp} target="_blank" rel="noopener noreferrer">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9" /><path d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1" /></svg>
    Pedir presupuesto
  </a>

  <details class="nav-phone">
    <summary>Menú</summary>
    <ul>
      {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      <li><a href={url('/#opiniones')}>Opiniones</a></li>
      <li><a href={url('/#preguntas-frecuentes')}>Preguntas frecuentes</a></li>
      <li><a href={url('/#contacto')}>Contacto</a></li>
      <li><a href={contact.whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp</a></li>
    </ul>
  </details>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 5.5rem;
    font-size: var(--step-body);
  }
  .brand { display: inline-flex; align-items: center; }
  .brand-logo { width: auto; height: 3.25rem; transition: transform 600ms var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .brand:hover .brand-logo { transform: rotate(-2deg); }
  }
  .nav-list { display: flex; gap: clamp(1.25rem, 2.6vw, 2.5rem); }
  .nav-link { text-decoration-color: transparent; }
  .header-action { min-height: 2.75rem; white-space: nowrap; }
  .header-action svg { width: 1.25rem; height: 1.25rem; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }

  .nav-phone { display: none; position: relative; }
  .nav-phone summary {
    list-style: none;
    cursor: pointer;
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    padding: 0 1rem;
    background: var(--surface);
    font-weight: 500;
  }
  .nav-phone summary::-webkit-details-marker { display: none; }
  .nav-phone[open] summary { background: var(--ink); color: var(--bg); }
  .nav-phone ul {
    position: absolute;
    right: 0;
    top: calc(100% + 0.5rem);
    min-width: 14rem;
    padding: 0.5rem 0;
    background: var(--ink);
    color: var(--bg);
  }
  .nav-phone a {
    display: block;
    padding: 0.75rem 1.25rem;
    text-decoration: none;
    font-size: var(--step-body);
  }
  .nav-phone a:active { background: var(--crimson); }

  @media (max-width: 60rem) {
    .nav, .header-action { display: none; }
    .nav-phone { display: block; }
    .site-header { min-height: 4.5rem; }
    .brand-logo { height: 2.75rem; }
  }
</style>
