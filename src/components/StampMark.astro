---
// The Amor Trazado mark: a perforated stamp with a four-petal flower and a heart.
// Drawn in currentColor so it takes the colour of its context.
interface Props {
  size?: number;
  class?: string;
}
const { size = 40, class: className } = Astro.props;
const id = `stamp-${Math.random().toString(36).slice(2, 8)}`;
const holes = Array.from({ length: 9 }, (_, i) => 10 + i * 10);
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 100 100"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <mask id={id}>
      <rect width="100" height="100" fill="#fff" />
      {holes.map((p) => (
        <>
          <circle cx={p} cy="0" r="3.4" fill="#000" />
          <circle cx={p} cy="100" r="3.4" fill="#000" />
          <circle cx="0" cy={p} r="3.4" fill="#000" />
          <circle cx="100" cy={p} r="3.4" fill="#000" />
        </>
      ))}
      <rect x="11" y="11" width="78" height="78" fill="none" stroke="#000" stroke-width="3" />
      <g fill="#000">
        <circle cx="50" cy="37" r="10" />
        <circle cx="50" cy="63" r="10" />
        <circle cx="37" cy="50" r="10" />
        <circle cx="63" cy="50" r="10" />
        <circle cx="50" cy="50" r="10" />
        <ellipse cx="24" cy="24" rx="7" ry="3.2" transform="rotate(45 24 24)" />
        <ellipse cx="76" cy="24" rx="7" ry="3.2" transform="rotate(-45 76 24)" />
        <ellipse cx="24" cy="76" rx="7" ry="3.2" transform="rotate(-45 24 76)" />
        <ellipse cx="76" cy="76" rx="7" ry="3.2" transform="rotate(45 76 76)" />
      </g>
      <path
        d="M50 58 C 41 51, 42 43, 46.5 43 C 48.5 43, 50 45, 50 46.5 C 50 45, 51.5 43, 53.5 43 C 58 43, 59 51, 50 58 Z"
        fill="#fff"
      />
    </mask>
  </defs>
  <rect width="100" height="100" fill="currentColor" mask={`url(#${id})`} />
</svg>
