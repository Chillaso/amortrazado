---
// Email with its address, then WhatsApp and Instagram as icons only. Icons from Tabler (MIT).
import { contact } from '../data/contact';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<ul class:list={['contact-icons', className]}>
  <li class="mail">
    <a class="link" href={`mailto:${contact.email}`}>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z" />
        <path d="M3 7l9 6l9 -6" />
      </svg>
      <span>{contact.email}</span>
    </a>
  </li>
  <li>
    <a class="icon" href={contact.whatsapp} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9" />
        <path d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1" />
      </svg>
    </a>
  </li>
  <li>
    <a class="icon" href={contact.instagram} target="_blank" rel="noopener noreferrer" aria-label={`Instagram ${contact.instagramHandle}`}>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 8a4 4 0 0 1 4 -4h8a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-8a4 4 0 0 1 -4 -4z" />
        <path d="M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0" />
        <path d="M16.5 7.5v.01" />
      </svg>
    </a>
  </li>
</ul>

<style>
  .contact-icons { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.75rem; }
  .mail { flex-basis: 100%; }
  .mail a { display: inline-flex; align-items: center; gap: 0.5rem; padding-block: 0.2rem; overflow-wrap: anywhere; }
  svg {
    width: 1.35rem;
    height: 1.35rem;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .icon {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    color: var(--crimson);
    transition: background-color 200ms ease, color 200ms ease;
  }
  .icon svg { width: 1.5rem; height: 1.5rem; }
  @media (hover: hover) and (pointer: fine) {
    .icon:hover { background: var(--crimson); color: #fff; }
  }
  .icon:focus-visible { outline: 2px solid var(--crimson); outline-offset: 3px; }
</style>
