---
import { url } from '../lib/url';
// One line of large type, then three prints hanging from one rail at three sizes.
---

<section class="hero wrap" aria-labelledby="hero-title">
  <div class="hero-grid grid">
    <h1 id="hero-title" class="hero-title" data-reveal>Bodas dibujadas a mano</h1>

    <figure class="print print-square perforated" data-reveal style="--i:1">
      <img
        src={url('/images/pieces/retrato-grupo-manos.webp')}
        width="624"
        height="628"
        alt="Manos sosteniendo una ilustración a acuarela de un grupo de amigos"
      />
    </figure>

    <div class="hero-copy" data-reveal style="--i:2">
      <p>
        Amor Trazado diseña e ilustra la papelería de vuestra boda (invitaciones, mapas, minutas,
        seating plan) y retratos personalizados para regalar.
      </p>
      <a class="button" href="#contacto">Contadme vuestra boda</a>
    </div>

    <figure class="print print-tall" data-reveal>
      <div class="shutter">
        <img
          src={url('/images/pieces/grullas.webp')}
          width="398"
          height="596"
          alt="Dos manos sostienen la invitación «La leyenda de las grullas de papel» delante de un muro de rosas"
          fetchpriority="high"
        />
      </div>
      <figcaption class="small muted">Invitación «La leyenda de las grullas de papel»</figcaption>
    </figure>

    <figure class="print print-wide" data-reveal style="--i:3">
      <img
        src={url('/images/pieces/invitacion-mesa.webp')}
        width="617"
        height="628"
        alt="Invitación de Marina y Carlos y mapa ilustrado de la celebración, con sobre verde salvia"
      />
      <figcaption class="small muted">Invitación y mapa ilustrado de Marina y Carlos</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    overflow-x: clip;
    padding-top: clamp(1rem, 4vh, 3rem);
    padding-bottom: calc(var(--section) / 2);
  }
  .hero-grid { align-items: start; }

  .hero-title {
    grid-column: 1 / -1;
    grid-row: 1;
    font-size: var(--step-display);
    line-height: 0.95;
    letter-spacing: -0.03em;
    margin-bottom: clamp(1.5rem, 4vh, 3rem);
  }

  .print { margin: 0; }
  .print img { width: 100%; height: 100%; object-fit: cover; background: var(--surface); }
  .print figcaption { margin-top: 0.75rem; max-width: 34ch; }

  .print-square { grid-column: 1 / span 2; grid-row: 2; aspect-ratio: 1; --r: 3.5px; }
  .print-tall { grid-column: 4 / span 4; grid-row: 2 / span 2; }
  .print-tall .shutter { aspect-ratio: 3 / 4; }
  .print-wide {
    grid-column: 9 / -1;
    grid-row: 2 / span 2;
    margin-right: calc(-1 * var(--margin) - 9vw);
  }
  .print-wide img { aspect-ratio: 16 / 10; }

  .hero-copy { grid-column: 1 / span 3; grid-row: 3; margin-top: 1.5rem; }
  .hero-copy p { max-width: 30ch; }
  .hero-copy .button { margin-top: 1.75rem; }

  @media (max-width: 75rem) {
    .print-square, .hero-copy { grid-column: 1 / span 3; }
  }

  @media (max-width: 48rem) {
    .hero { padding-top: 0.5rem; }
    .hero-title { font-size: clamp(2.25rem, 10.5vw, 3.5rem); }
    .print-tall { grid-column: 1 / span 9; grid-row: 2; }
    .print-tall figcaption { display: none; }
    .print-square {
      grid-column: 8 / -1;
      grid-row: 3;
      margin-top: -2.5rem;
      position: relative;
      z-index: 1;
    }
    .hero-copy { grid-column: 1 / span 7; grid-row: 3; margin-top: 1.25rem; }
    .hero-copy .button { white-space: normal; text-align: center; padding-inline: 1rem; }
    .print-wide {
      grid-column: 1 / -1;
      grid-row: 4;
      margin: calc(var(--section) / 3) calc(-1 * var(--margin)) 0;
    }
    .print-wide figcaption { padding-inline: var(--margin); }
  }
</style>
