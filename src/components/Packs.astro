---
// The packs as hand-cut cards in the brand colours, laid loosely on the table.
const packs = [
  {
    name: 'Ilustración sencilla',
    note: '2 revisiones',
    items: ['Retrato o elemento único', 'Entrega digital o impresa'],
    tone: 'crimson',
    tilt: -1.5,
  },
  {
    name: 'Papelería de boda completa',
    note: 'revisiones a medida',
    items: [
      'Invitación y sobres',
      'Seating plan',
      'Minutas y meseros',
      'Tarjetas',
      'Sello de pareja',
      'Capitanes de mesa',
    ],
    tone: 'blush',
    tilt: 1,
    featured: true,
  },
  {
    name: 'Invitación',
    note: '3 revisiones',
    items: ['Ilustración y diseño', 'Sobres (opcional)', 'Versión digital e impresión', 'Asesoría de estilo'],
    tone: 'sage',
    tilt: 1.2,
  },
  {
    name: 'Ilustración y papelería',
    note: 'digital e impresa',
    items: ['Retrato de la pareja', 'Invitación y sobres', 'Cartelería'],
    tone: 'sage',
    tilt: -1,
  },
  {
    name: 'Pack digital',
    note: 'como extra',
    items: ['Invitación digital animada', 'Plantillas editables', 'Ilustraciones para redes'],
    tone: 'crimson',
    tilt: 1.6,
  },
];
---

<section id="packs" class="packs wrap section" aria-labelledby="packs-title">
  <div class="packs-head">
    <h2 id="packs-title" class="head">Packs</h2>
    <p>
      Cada boda es distinta: contadme vuestra fecha y cuántas piezas necesitáis y os preparo un
      presupuesto cerrado, <span data-annotate="circle" data-padding="6">sin compromiso</span>.
    </p>
    <a class="button" href="#contacto">Pedir presupuesto</a>
  </div>

  <ul class="cards" data-deal-group>
    {packs.map((p) => (
      <li data-deal class={`card tone-${p.tone}${p.featured ? ' featured' : ''}`} style={`--tilt:${p.tilt}deg`}>
        <h3>{p.name}</h3>
        <ul class="checks">
          {p.items.map((i) => <li>{i}</li>)}
        </ul>
        <p class="note card-note">{p.note}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  .packs {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 3rem var(--gutter);
    align-items: start;
  }
  .packs-head { position: sticky; top: 2rem; }
  .packs-head p { margin-top: 1.25rem; max-width: 30ch; }
  .packs-head .button { margin-top: 2rem; }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem 1.25rem;
    align-items: start;
  }
  .card {
    display: flex;
    flex-direction: column;
    padding: 1.75rem 1.5rem 1.4rem;
    border-radius: var(--cut);
    rotate: var(--tilt);
    transition: rotate 300ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .card:hover { rotate: 0deg; }
  }
  .featured { grid-row: span 2; }
  .card:nth-child(4) { margin-top: -1rem; }

  .card h3 { font-size: var(--step-lead); line-height: 1.1; }
  .card .checks { display: grid; gap: 0.4rem; margin-top: 1.1rem; line-height: 1.35; }
  .card-note { margin-top: 1.25rem; font-size: 1.5rem; color: inherit; opacity: 0.9; }

  .tone-crimson { background: var(--crimson); color: #fff; }
  .tone-crimson .checks li::before { background: #fff; }
  .tone-sage { background: var(--sage); color: var(--ink); }
  .tone-sage .checks li::before { background: var(--ink); }
  .tone-blush { background: var(--blush); color: var(--ink); }

  @media (max-width: 64rem) {
    .packs { grid-template-columns: 1fr; }
    .packs-head { position: static; }
  }
  @media (max-width: 48rem) {
    .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .featured { grid-row: auto; grid-column: 1 / -1; order: -1; }
    .card:nth-child(4) { margin-top: 0; }
  }
  @media (max-width: 30rem) {
    .cards { grid-template-columns: 1fr; }
    .card { rotate: calc(var(--tilt) * 0.5); }
  }
</style>
